DATABASE_URL=postgresql+psycopg://niramaya_app:YOUR_POSTGRES_PASSWORD@localhost:5432/niramayaai
JWT_SECRET_KEY=REPLACE_WITH_OUTPUT_FROM_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ISSUER=
JWT_AUDIENCE=
FRONTEND_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# AWS S3 Storage
AWS_REGION=eu-north-1
S3_BUCKET_NAME=your-private-medical-bucket
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Groq LLM API
LLM_API_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
RAG_GENERATION_ENABLED=true
LLM_TIMEOUT_SECONDS=90
LLM_API_KEY=

# Qdrant Vector Database
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=niramayaai

